{
  "name": "skytrace",
  "private": true,
  "version": "1.0.0",
  "description": "SkyTrace — find what crossed your sky. A satellite trace instrument PWA.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test:engine": "node --experimental-strip-types scripts/engine-test.ts",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "gsap": "^3.15.0",
    "idb": "^8.0.3",
    "lucide": "^1.49.0",
    "satellite.js": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
